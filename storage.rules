rules_version = '2';

// =============================================================
// VENDELOO — Reglas de Storage
// =============================================================
// Las imágenes de producto son públicas (se muestran en la web),
// pero cada quien solo escribe dentro de su propia carpeta, y solo
// imágenes de hasta 5 MB. Sin esto, cualquiera podía subir un
// ejecutable de 2 GB a costa tuya.
// =============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Las fotos de producto solo las sube quien puede publicar. Antes
    // cualquier comprador podía escribir en auctions/<su-uid>/ y subir
    // 5 MB por archivo sin límite de cantidad: puro costo de almacenamiento
    // y de salida, a cuenta del proyecto.
    function esVendedorAprobado() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.sellerStatus == 'approved';
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)');
    }

    // Fotos de subastas y productos
    match /auctions/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && esVendedorAprobado() && isImageUnder5MB();
      allow delete: if isOwner(userId);
    }

    match /products/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && esVendedorAprobado() && isImageUnder5MB();
      allow delete: if isOwner(userId);
    }

    // Portadas de shows
    match /shows/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && esVendedorAprobado() && isImageUnder5MB();
      allow delete: if isOwner(userId);
    }

    // Avatares
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isImageUnder5MB();
      allow delete: if isOwner(userId);
    }

    // Todo lo demás: cerrado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
