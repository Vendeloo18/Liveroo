rules_version = '2';

// =============================================================
// LIVEROO — Reglas de Storage
// =============================================================
// Las imágenes de producto son públicas (se muestran en la web),
// pero cada quien solo escribe dentro de su propia carpeta, y solo
// imágenes de hasta 5 MB. Sin esto, cualquiera podía subir un
// ejecutable de 2 GB a costa tuya.
// =============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de subastas y productos
    match /auctions/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageUnder5MB();
    }

    match /products/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageUnder5MB();
    }

    // Portadas de shows
    match /shows/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageUnder5MB();
    }

    // Avatares
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageUnder5MB();
    }

    // Todo lo demás: cerrado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
