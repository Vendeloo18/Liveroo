rules_version = '2';

// =============================================================
// VENDELOO — Reglas de seguridad de Firestore
// =============================================================
// Principio: el cliente NUNCA fija un precio ni cierra una subasta.
// Solo puede pedir una puja creando un doc en /pendingBids; el resto
// lo decide el motor (Cloud Functions), que ignora estas reglas.
//
// Todo lo que no esté explícitamente permitido aquí, queda denegado.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // get() dentro de reglas no pasa por reglas: puede leer /users
    // aunque el cliente no pueda.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isApprovedSeller() {
      return isSignedIn()
        && userDoc().role in ['seller', 'admin']
        && userDoc().sellerStatus == 'approved';
    }

    // La escritura solo toca las claves listadas (nada más se mueve)
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ── /users — datos privados: email, teléfono, cédula ────────
    // Solo los ve su dueño. Lo que el público necesita ver está
    // duplicado en /publicProfiles.

    match /users/{userId} {
      allow get: if isSignedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();

      // Al registrarse nadie nace vendedor ni admin, y nadie se inventa
      // reputación: las métricas las escribe solo el motor.
      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'buyer'
        && request.resource.data.sellerStatus == 'none'
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'avatar', 'phone', 'whatsapp',
             'role', 'sellerStatus', 'ratingAvg', 'ratingCount', 'totalSales',
             'totalPurchases', 'createdAt', 'updatedAt'
           ])
        && (!('ratingAvg' in request.resource.data) || request.resource.data.ratingAvg == 0)
        && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0)
        && (!('totalSales' in request.resource.data) || request.resource.data.totalSales == 0)
        && (!('totalPurchases' in request.resource.data) || request.resource.data.totalPurchases == 0);

      // El rol, el estado de vendedor y las métricas las mueve el motor
      allow update: if (isSignedIn()
        && uid() == userId
        && onlyChanges([
             'displayName', 'avatar', 'username', 'city', 'phone', 'whatsapp',
             'cedula', 'shopName', 'sellerCat', 'fcmToken', 'onboardingDone',
             'notifPrefs', 'currencyPref', 'updatedAt'
           ]))
        || (
          // Solicitar ser vendedor: el ÚNICO movimiento de sellerStatus que
          // puede hacer un usuario es none → pending, con los datos de la
          // tienda en la misma escritura. Aprobar y suspender siguen siendo
          // del motor (approveSeller / suspendSeller). Sin esta rama, el
          // botón "Quiero vender" era un callejón sin salida: nada en la
          // app podía escribir la solicitud que el panel espera revisar.
          isSignedIn()
          && uid() == userId
          && onlyChanges(['sellerStatus', 'shopName', 'sellerCat', 'cedula', 'whatsapp', 'city', 'phone', 'updatedAt'])
          && (!('sellerStatus' in resource.data) || resource.data.sellerStatus == 'none')
          && request.resource.data.sellerStatus == 'pending'
          && request.resource.data.shopName is string
          && request.resource.data.shopName.size() >= 3
          && request.resource.data.cedula is string
          && request.resource.data.cedula.matches('^V-[0-9]{6,9}$')
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.matches('^\\+58[0-9]{10}$')
          && request.resource.data.city is string
          && request.resource.data.sellerCat is string
        );

      allow delete: if false;
    }

    // ── /publicProfiles — la cara pública de un usuario ─────────
    // La mantiene sincronizada una Cloud Function. Nadie la escribe.

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ── /auctions — subastas, en vivo y sueltas ─────────────────

    match /auctions/{auctionId} {
      allow read: if true;

      // El vendedor publica su subasta. El precio de partida es suyo,
      // pero no puede nacer con pujas ni con ganador puesto a mano.
      // isDemo fuera del alcance del cliente: con esa marca el motor cierra
      // SIN cobrar ni crear orden, así que un vendedor podía retener el saldo
      // de los compradores toda la subasta y no venderles nada.
      // timerSeconds acotado: un valor absurdo reventaba la transacción de
      // cierre y dejaba la retención del ganador congelada para siempre.
      allow create: if isApprovedSeller()
        && !('isDemo' in request.resource.data)
        && (!('timerSeconds' in request.resource.data)
            || (request.resource.data.timerSeconds is int
                && request.resource.data.timerSeconds >= 5
                && request.resource.data.timerSeconds <= 3600))
        && request.resource.data.sellerId == uid()
        && request.resource.data.mode in ['live', 'standalone']
        && request.resource.data.bidsCount == 0
        && request.resource.data.currentBidderId == null
        && request.resource.data.currentBidUsd == request.resource.data.startingPriceUsd
        && request.resource.data.startingPriceUsd is number
        && request.resource.data.startingPriceUsd > 0
        && request.resource.data.minIncrementUsd is number
        && request.resource.data.minIncrementUsd > 0
        && request.resource.data.winnerId == null
        && request.resource.data.orderId == null
        && (
          // En vivo: nace en cola, y SOLO en un show del propio vendedor.
          // Sin el get, cualquier vendedor podía colar su producto en el
          // show de otro y el motor lo subastaba ahí.
          (request.resource.data.mode == 'live'
            && request.resource.data.status == 'waiting'
            && request.resource.data.showId is string
            && get(/databases/$(database)/documents/shows/$(request.resource.data.showId)).data.sellerId == uid())
          ||
          // Suelta: nace activa y con fecha de cierre en el futuro
          (request.resource.data.mode == 'standalone'
            && request.resource.data.status == 'active'
            && request.resource.data.showId == null
            && request.resource.data.endsAt is timestamp
            && request.resource.data.endsAt > request.time)
        );

      // Se puede corregir la ficha solo mientras nadie haya pujado.
      // El precio, el estado y el ganador quedan fuera del alcance.
      allow update: if isApprovedSeller()
        && resource.data.sellerId == uid()
        && resource.data.bidsCount == 0
        && resource.data.status in ['draft', 'waiting']
        && onlyChanges([
             'title', 'description', 'imageURL', 'imageURLs', 'category',
             'startingPriceUsd', 'currentBidUsd', 'minIncrementUsd',
             'timerSeconds', 'sortOrder', 'updatedAt'
           ])
        && request.resource.data.currentBidUsd == request.resource.data.startingPriceUsd;

      allow delete: if isApprovedSeller()
        && resource.data.sellerId == uid()
        && resource.data.bidsCount == 0
        && resource.data.status in ['draft', 'waiting'];

      // Historial de pujas: público para leer, intocable para escribir
      match /bids/{bidId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // La pantalla de Actividad consulta las pujas del usuario con un
    // collectionGroup, y esas consultas NO heredan la regla de arriba:
    // necesitan una propia que cubra el grupo entero.
    // Por subasta el historial es público (regla anidada de arriba). Este
    // comodín solo lo usan las consultas de grupo de Actividad/Avisos, que
    // son sobre uno mismo: sin este filtro, cualquiera podía perfilar a otro
    // comprador (qué compra, cuánto paga) en toda la plataforma.
    match /{path=**}/bids/{bidId} {
      // El admin sí necesita el grupo entero: la ficha de una persona en la
      // consola muestra su historial de ofertas para poder atender un reclamo.
      allow read: if isSignedIn() && (resource.data.bidderId == uid() || isAdmin());
      allow write: if false;
    }

    // ── /pendingBids — la única puerta para pujar ───────────────
    // El cliente pide; el motor decide. Nadie puede editar su
    // propia solicitud después de crearla.

    match /pendingBids/{pendingBidId} {
      allow get: if isSignedIn() && resource.data.bidderId == uid();
      allow list: if isSignedIn() && resource.data.bidderId == uid();

      // Lista blanca y topes: cada documento aquí despierta una Function y
      // abre una transacción sobre la subasta activa, así que un documento
      // inflado o con campos de más sale caro. El límite por segundo no se
      // puede expresar en reglas: para eso está App Check.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['auctionId', 'bidderId', 'amountUsd', 'status', 'submittedAt']
           )
        && request.resource.data.bidderId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.auctionId is string
        && request.resource.data.auctionId.size() > 0
        && request.resource.data.auctionId.size() <= 60
        && request.resource.data.amountUsd is number
        && request.resource.data.amountUsd > 0
        && request.resource.data.amountUsd < 1000000;

      allow update, delete: if false;
    }

    // ── /shows ─────────────────────────────────────────────────

    match /shows/{showId} {
      allow read: if true;

      // Sin agoraChannelName ni viewerCount inflado: el canal lo decide el
      // servidor (es el id del show) y la audiencia arranca en cero.
      allow create: if isApprovedSeller()
        && request.resource.data.sellerId == uid()
        && request.resource.data.status in ['draft', 'scheduled']
        && !('agoraChannelName' in request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && (!('viewerCount' in request.resource.data) || request.resource.data.viewerCount == 0);

      // status, startedAt, endedAt y currentAuctionId los mueve el motor:
      // por eso el vendedor ya no puede escribir status:"live" a mano.
      allow update: if (
        isApprovedSeller()
        && resource.data.sellerId == uid()
        && onlyChanges([
             'title', 'description', 'coverImageURL', 'category',
             'scheduledAt', 'updatedAt'
           ])
      ) || (
        // Contador de espectadores: de uno en uno, sube al entrar y baja
        // al salir (nunca bajo cero). Es una métrica de vanidad; si se
        // vuelve importante, la mueve una Function con presencia real.
        // Solo mientras transmite y con techo: fuera del vivo no hay nada
        // que contar, y así no se puede hundir/inflar el orden del home.
        isSignedIn()
        && resource.data.status == 'live'
        && onlyChanges(['viewerCount'])
        && request.resource.data.viewerCount <= 100000
        && (
          request.resource.data.viewerCount == resource.data.viewerCount + 1
          || (request.resource.data.viewerCount == resource.data.viewerCount - 1
              && resource.data.viewerCount > 0)
        )
      );

      allow delete: if isApprovedSeller()
        && resource.data.sellerId == uid()
        && resource.data.status in ['draft', 'scheduled'];

      // Chat en vivo
      match /messages/{messageId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.authorId == uid()
          // El nombre que se muestra es el del perfil real: sin esto se
          // podía chatear suplantando a cualquiera con authorId propio.
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(uid())).data.displayName
          && request.resource.data.type == 'chat'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          // La hora la pone el servidor. Con fecha libre se podían mandar
          // 40 mensajes fechados en el año 2999: se clavaban arriba de la
          // ventana de chat de TODOS y ningún mensaje nuevo volvía a verse,
          // ni siquiera los del sistema ("Fulano ganó"). El cliente ya
          // manda serverTimestamp(), así que esto no cambia nada legítimo.
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(
               ['showId', 'authorId', 'authorName', 'type', 'text', 'createdAt']
             )
          && get(/databases/$(database)/documents/shows/$(showId)).data.status == 'live';

        allow update: if false;
        allow delete: if isAdmin()
          || get(/databases/$(database)/documents/shows/$(showId)).data.sellerId == uid();
      }

      // Reacciones: solo por sendReaction, que valida el show, el emoji y
      // aplica límite de frecuencia. cleanupOldReactions las elimina luego.
      match /reactions/{reactionId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── /orders — las crea el motor al cerrar una subasta ───────
    // La condición aplica documento por documento, así que una
    // consulta sin filtrar por buyerId o sellerId falla entera.

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == uid()
        || resource.data.sellerId == uid()
        || isAdmin()
      );

      allow create: if false;

      // El ciclo (pending_payment → payment_confirmed → shipped →
      // delivered) lo mueve SOLO la función advanceOrder, que valida la
      // transición de origen. Antes las reglas validaban el destino y un
      // vendedor podía saltar a 'shipped', devolver una entregada o
      // cancelar una pagada. El cliente solo toca metadatos sin estado.
      allow update: if isSignedIn() && (
        // El vendedor anota el tracking o marca el mensaje enviado
        (resource.data.sellerId == uid()
          && onlyChanges(['whatsappMessageSent', 'trackingCode', 'updatedAt']))
        ||
        // El comprador deja su contacto
        (resource.data.buyerId == uid()
          && onlyChanges(['buyerWhatsapp', 'updatedAt']))
        ||
        // El admin mueve el estado y anota, pero NO toca la plata ni la
        // liquidación: marcar 'payoutStatus: paid' a mano dejaba al
        // vendedor cobrado sin registro en /sellerPayouts, y esa es la
        // única auditoría de qué se le pagó a quién. Eso pasa por
        // markSellerPaid, que sí deja el rastro.
        (isAdmin() && onlyChanges([
          'status', 'cancelledReason', 'disputeNote', 'adminNote',
          'paymentConfirmedAt', 'paymentConfirmedBy', 'shippedAt',
          'deliveredAt', 'updatedAt',
        ]))
      );

      allow delete: if false;
    }

    // ── /ratings — el comprador califica al vendedor ────────────

    match /ratings/{ratingId} {
      allow read: if true;

      // Las crea SOLO la función submitRating: exige orden entregada, que
      // el autor sea el comprador y una única calificación por orden (el
      // ID del rating es el orderId). Antes cualquier usuario podía crear
      // ratings ilimitados a cualquier UID y inflar o hundir reputaciones.
      allow create: if false;

      allow update, delete: if false;
    }

    // ── Configuración — pública para leer, admin vía Function ───

    match /config/{docId} {
      // paymentAccounts trae teléfono, cédula y correo de Zelle: eso no
      // se le muestra a internet entera, solo a quien tiene sesión (el
      // que va a recargar). El resto de la config sí es pública.
      allow read: if docId != 'paymentAccounts' || isSignedIn();
      // paymentAccounts y wallet (interruptor "pujar exige saldo") los
      // edita el admin desde el panel. commission solo por Function.
      allow write: if isAdmin() && docId in ["paymentAccounts", "wallet"];
    }

    match /exchangeRates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Billetera — todavía sin backend, cerrada al cliente ─────
    // Cuando se implemente, los movimientos los escribe una Function.

    match /wallets/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow write: if false;
    }

    match /walletTransactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow write: if false;
    }

    // La única puerta de entrada de plata: el usuario DECLARA que envió
    // (pago móvil, Zelle…) y el admin decide por manageDeposit, que
    // acredita en la misma transacción. La solicitud no se puede editar
    // ni borrar después de creada: es la constancia de ambas partes.
    // ── /sellerPayouts — liquidaciones de la plataforma al vendedor ──
    // Las escribe solo markSellerPaid. El vendedor ve las suyas.
    match /sellerPayouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == uid() || isAdmin());
      allow write: if false;
    }

    match /deposits/{depositId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.status == "pending"
        && request.resource.data.amountUsd is number
        && request.resource.data.amountUsd > 0
        && request.resource.data.amountUsd <= 100000
        && request.resource.data.method in ["pago_movil", "zelle", "binance", "efectivo"]
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 4
        && request.resource.data.reference.size() <= 60;

      allow update, delete: if false;
    }

    // ── Cierre por defecto ──────────────────────────────────────
    // No otorga nada: está para dejar constancia de que cualquier
    // colección nueva nace denegada hasta que se le escriba su regla.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
