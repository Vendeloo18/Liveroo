{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "lib",
    "rootDir": "src",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Ver la nota en apps/web/tsconfig.json: sin acotar esto, TypeScript
    // carga cualquier @types/* del node_modules aplanado, incluidos
    // stubs vacíos que hacen fallar el build.
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
